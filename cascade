# Warn about floor edges that do NOT close a cycle: when consumer C depends on
# provider P, P is later in the canonical order, and P has no (transitive)
# dependency back on C, the pair is a plain one-way dependency and the order
# itself should change — C belongs after P. (This audit is what catches a
# mis-seeded canonical order; it found ProtoTap being placed before tool-base.)
audit_order() { # $1: full "up down" relation
    local rel="$1"
    {
        printf '%s\n' "$rel" | sed 's/^/R /'
        printf '%s\n' "$rel" | floor_edges | sed 's/^/F /'
    } | awk '
    $1 == "R" { dep[$3 SUBSEP $2] = 1; seen[$2] = 1; seen[$3] = 1; next }
    $1 == "F" { M++; fp[M] = $2; fc[M] = $3 }
    END {
        for (x in seen) nodes[++N] = x
        for (i = 1; i <= N; i++) for (j = 1; j <= N; j++)
            r[nodes[i] SUBSEP nodes[j]] = dep[nodes[i] SUBSEP nodes[j]]
        for (k = 1; k <= N; k++) for (i = 1; i <= N; i++) for (j = 1; j <= N; j++)
            if (r[nodes[i] SUBSEP nodes[k]] && r[nodes[k] SUBSEP nodes[j]])
                r[nodes[i] SUBSEP nodes[j]] = 1
        for (m = 1; m <= M; m++)
            if (!r[fp[m] SUBSEP fc[m]])
                printf "!! order: %s depends on %s one-way — consider moving %s after %s\n", fc[m], fp[m], fc[m], fp[m]
    }' >&2
}


# Highest provable state for one repo. Never trusts the cached value.
derive_state() { # <wave> <repo> -> prints state
    local wave="$1" repo="$2" dir="$SUMMIT/$repo" branch cls
    branch="$(mget "$wave" .branch)"; cls="$(meta_class "$repo")"

    local parked; parked="$(mget "$wave" --arg r "$repo" '.repos[$r].parked // empty')"
    [ -n "$parked" ] && { echo parked; return; }

    git -C "$dir" rev-parse --verify -q "$branch" >/dev/null 2>&1 || { echo pending; return; }

    # Terminal state, checked first: once the wave's target version is served by
    # the registry, this repository is done. Without this the derivation reads a
    # MERGED branch as `pending` -- after the merge `origin/$BASE..$branch` is
    # empty, so the branch looks like it never had work -- and the wave asks to
    # prep and rebuild a repository it has already shipped.
    local tvp; tvp="$(mget "$wave" --arg r "$repo" '.repos[$r].target_version // empty')"
    if [ -n "$tvp" ] && registry_has "$repo" "$tvp"; then
        echo published-remote; return
    fi

    local subjects
    subjects="$(git -C "$dir" log --format=%s "origin/$BASE..$branch" 2>/dev/null || true)"

    # pulled: the pull commit exists, or config was already current (nothing staged).
    local pulled=0
    printf '%s' "$subjects" | grep -q '^Update shared agent tooling' && pulled=1
    [ "$pulled" = 1 ] || { printf '%s' "$subjects" | grep -q '.' && pulled=1; }  # branch has work => prep ran
    [ "$pulled" = 1 ] || { echo pending; return; }

    # pinned: by CONTENT — every recorded pin still present in the pin files.
    local ok=1 up pf pv have
    for up in $(upstreams_of "$wave" "$repo"); do
        pv="$(mget "$wave" --arg r "$repo" --arg u "$up" '.repos[$r].pin_vector[$u] // empty')"
        [ -n "$pv" ] || { ok=0; break; }
        pf="$SUMMIT/$repo/buildSrc/src/main/kotlin/io/spine/dependency/local/$(repo_pin_file "$up")"
        for c in $(repo_track_constants "$up"); do
            have="$(read_pin_constant_at "$dir" "$branch" \
                    "buildSrc/src/main/kotlin/io/spine/dependency/local/$(repo_pin_file "$up")" "$c")"
            [ "$have" = "$pv" ] || { ok=0; break 2; }
        done
    done
    [ "$ok" = 1 ] || { echo pulled; return; }

    # bumped (library repos): the wave branch's version differs from base and
    # matches the recorded target.
    if [ "$cls" = library ]; then
        local tv cur basev
        tv="$(mget "$wave" --arg r "$repo" '.repos[$r].target_version // empty')"
        cur="$(version_of "$repo" "$branch")"
        basev="$(version_of "$repo" "origin/$BASE")"
        { [ -n "$cur" ] && [ "$cur" != "$basev" ] && { [ -z "$tv" ] || [ "$cur" = "$tv" ]; }; } \
            || { echo pinned; return; }
    fi

    # built: recorded success still anchored to the branch head.
    local bsha head
    bsha="$(mget "$wave" --arg r "$repo" '.repos[$r].built.head // empty')"
    head="$(git -C "$dir" rev-parse "$branch")"
    [ -n "$bsha" ] && [ "$bsha" = "$head" ] || { echo bumped; return; }

    # published-local (library): the target version sits in ~/.m2.
    if [ "$cls" = library ]; then
        local tv gp mk
        tv="$(mget "$wave" --arg r "$repo" '.repos[$r].target_version')"
        gp="$(meta_group "$repo")"; mk="$(meta_marker "$repo")"
        [ -d "$M2/$gp/$mk/$tv" ] || { echo built; return; }
    fi

    # pr-ready: PASS sentinel at HEAD.
    local gitdir s_head s_status
    gitdir="$(git -C "$dir" rev-parse --absolute-git-dir)"
    s_head="$(sed -n 's/^head=//p' "$gitdir/pre-pr.ok" 2>/dev/null || true)"
    s_status="$(sed -n 's/^status=//p' "$gitdir/pre-pr.ok" 2>/dev/null || true)"
    { [ "$s_status" = PASS ] && [ "$s_head" = "$head" ]; } || { echo published-local; return; }

    # pr-open / merged.
    local prstate
    prstate="$(gh pr view "$branch" -R "$ORG/$repo" --json state --jq .state 2>/dev/null || true)"
    case "$prstate" in
        MERGED) ;;
        OPEN)   echo pr-open; return ;;
        *)      echo pr-ready; return ;;
    esac

    # published-remote (library): registry serves the target.
    if [ "$cls" = library ]; then
        local tv; tv="$(mget "$wave" --arg r "$repo" '.repos[$r].target_version')"
        registry_has "$repo" "$tv" || { echo merged; return; }
        echo published-remote; return
    fi
    echo published-remote   # verify-only: merged is terminal
}

cmd_status() {
    local wave="${1:-$(active_wave)}"
    [ -f "$(manifest_path "$wave")" ] || die "no manifest for wave '$wave'"
    local repo st blocked up upst wbranch
    wbranch="$(mget "$wave" .branch)"
    printf '%-20s %-17s %-24s %s\n' REPO STATE VERSION NOTE
    for repo in $(mget "$wave" '.order[]'); do
        mget "$wave" --arg r "$repo" '.repos[$r] // empty' | grep -q . || continue
        st="$(derive_state "$wave" "$repo")"
        # blocked is derived, never stored: some transitive upstream parked/halted.
        blocked=""
        if [ "$st" != parked ]; then
            for up in $(upstreams_of "$wave" "$repo"); do
                upst="$(mget "$wave" --arg r "$up" '.repos[$r].state // empty')"
                [ "$upst" = parked ] && blocked="blocked by $up"
            done
        fi
        mset "$wave" '.repos[$r].state = $s' --arg r "$repo" --arg s "$st"
        printf '%-20s %-17s %-24s %s\n' "$repo" "${blocked:+blocked}${blocked:-$st}" \
            "$(mget "$wave" --arg r "$repo" '.repos[$r].target_version // empty' \
               | grep . || version_of "$repo" "$wbranch" 2>/dev/null | grep . || echo "—")" \
            "${blocked:-$(mget "$wave" --arg r "$repo" '.repos[$r].parked // ""')}"
    done
    [ "$(mget "$wave" '.halted // empty')" != "" ] && warn "WAVE HALTED: $(mget "$wave" .halted)"
    return 0
}

# ---------------------------------------------------------------------------
# next — pure function of status: what should happen now
# ---------------------------------------------------------------------------

cmd_next() {
    local wave json=0
    wave="$(active_wave)"
    [ "${1:-}" = "--json" ] && json=1
    cmd_status "$wave" >/dev/null    # refresh derived states first

    [ "$(mget "$wave" '.halted // empty')" != "" ] && { echo "HALTED $(mget "$wave" .halted)"; exit 5; }

    local actions="" repo st up upok upst done_all=1
    for repo in $(mget "$wave" '.order[]'); do
        mget "$wave" --arg r "$repo" '.repos[$r] // empty' | grep -q . || continue
        st="$(mget "$wave" --arg r "$repo" '.repos[$r].state')"
        [ "$st" = published-remote ] || done_all=0
        # A parked transitive upstream blocks everything downstream.
        for up in $(upstreams_of "$wave" "$repo"); do
            [ "$(mget "$wave" --arg r "$up" '.repos[$r].state // empty')" = parked ] && st=blocked
        done
        case "$st" in
            pending|pulled|pinned) actions="$actions PREP:$repo" ;;
            bumped)               actions="$actions BUILD:$repo" ;;
            built|published-local)
                # Ship needs every in-wave upstream published; else we wait.
                upok=1
                for up in $(upstreams_of "$wave" "$repo"); do
                    upst="$(mget "$wave" --arg r "$up" '.repos[$r].state // empty')"
                    [ "$upst" = published-remote ] || upok=0
                done
                if [ "$st" = built ]; then actions="$actions PREPR:$repo"
                elif [ "$upok" = 1 ]; then actions="$actions PREPR:$repo"
                else actions="$actions WAIT-UPSTREAM:$repo"; fi ;;
            pr-ready)
                upok=1
                for up in $(upstreams_of "$wave" "$repo"); do
                    upst="$(mget "$wave" --arg r "$up" '.repos[$r].state // empty')"
                    [ "$upst" = published-remote ] || upok=0
                done
                if [ "$upok" = 1 ]; then actions="$actions SHIP:$repo"
                else actions="$actions WAIT-UPSTREAM:$repo"; fi ;;
            pr-open)  actions="$actions WAIT-REVIEW:$repo" ;;
            merged)   actions="$actions WAIT-PUBLISH:$repo" ;;
            parked|blocked|published-remote) ;;
        esac
    done
    if [ "$done_all" = 1 ]; then
        if [ "$(mget "$wave" '.closing_pr // empty')" = "" ]; then actions="CLOSE"
        else actions="DONE"; fi
    fi
    [ -z "$actions" ] && actions="WAIT"
    if [ "$json" = 1 ]; then
        printf '%s\n' $actions | jq -R 'split(":") | {action: .[0], repo: (.[1] // null)}' | jq -s .
    else
        printf '%s\n' $actions
    fi
}

# ---------------------------------------------------------------------------
# prep — branch, pull, pins, version
# ---------------------------------------------------------------------------

cmd_prep() {
    local repo="${1:?usage: cascade prep <repo>}" wave
    wave="$(active_wave)"
    require_submodule "$repo"; require_java
    local dir="$SUMMIT/$repo" branch cls
    branch="$(mget "$wave" .branch)"; cls="$(meta_class "$repo")"
    cd "$dir"

    # Branch off a fresh base (re-entrant).
    if [ "$(git rev-parse --abbrev-ref HEAD)" != "$branch" ]; then
        git fetch --quiet origin "$BASE"
        git checkout -q "$BASE"; git pull --ff-only --quiet origin "$BASE"
        git switch -q -c "$branch" 2>/dev/null || git switch -q "$branch"
    fi

    # ./config/pull — commit only what it actually changed. A repo that does not
    # consume `config` (its own hand-written buildSrc, no `config` submodule) has
    # nothing to pull; skipping keeps it a wave participant instead of a hard error.
    if [ ! -x ./config/pull ]; then
        note "$repo does not consume \`config\` — no pull step"
    elif ! git log --format=%s "origin/$BASE..HEAD" | grep -q '^Update shared agent tooling'; then
        [ -z "$(git status --porcelain)" ] \
            || die "working tree not clean before ./config/pull at $repo — commit or stash first"
        ./config/pull
        if [ -n "$(git status --porcelain)" ]; then
            git add -A
            git commit -q -m "Update shared agent tooling and config (./config/pull)"
        else
            note "config already current in $repo — no pull commit"
        fi
    else
        note "shared tooling already pulled on this branch — skipping"
    fi

    # Apply the wave's pin deltas (in-wave upstreams only).
    local up upver pf c cur cur_re nfound
    for up in $(upstreams_of "$wave" "$repo"); do
        case "$(mget "$wave" .kind)" in
            retarget) upver="$(mget "$wave" .target)" ;;
            *)
                if [ "$up" = "$(mget "$wave" '.seed.repo // empty')" ] \
                   && [ -n "$(mget "$wave" '.seed.version // empty')" ] ; then
                    upver="$(mget "$wave" '.seed.version')"
                else
                    upver="$(version_of "$up" "$branch" 2>/dev/null || true)"
                    [ -n "$upver" ] || upver="$(version_of "$up")"
                fi ;;
        esac
        [ -n "$upver" ] || die "cannot determine wave version of upstream $up (has its prep run?)"
        pf="buildSrc/src/main/kotlin/io/spine/dependency/local/$(repo_pin_file "$up")"
        [ -f "$pf" ] || die "$repo has no $pf — unexpected layout"
        for c in $(repo_track_constants "$up"); do
            cur="$(read_pin_constant "$pf" "$c")"
            [ -n "$cur" ] || { warn "constant $c not found in $repo/$pf — edit by hand (cascade-adapt), then re-run: ./cascade prep $repo"; exit 3; }
            [ "$cur" = "$upver" ] && continue
            write_pin_constant "$pf" "$c" "$cur" "$upver"
            nfound="$(grep -cE "$(pin_const_re "$c")${upver//./\\.}\"" "$pf" || true)"
            [ "$nfound" -ge 1 ] || { git checkout -- "$pf"; warn "pin edit verification failed for $up.$c in $repo — fix by hand, then re-run: ./cascade prep $repo"; exit 3; }
        done
        mset "$wave" '.repos[$r].pin_vector[$u] = $v' --arg r "$repo" --arg u "$up" --arg v "$upver"
    done
    if [ -n "$(git status --porcelain "buildSrc/src/main/kotlin/io/spine/dependency/local/" 2>/dev/null)" ]; then
        git add buildSrc/src/main/kotlin/io/spine/dependency/local/
        git commit -q -m "Update local dependency pins"
    fi

    # Version step (library repos only).
    if [ "$cls" = library ]; then
        local f=version.gradle.kts kind cur next prop
        kind="$(mget "$wave" .kind)"; prop="$(meta_vprop "$repo")"
        cur="$(version_of "$repo")"
        [ -n "$cur" ] || die "cannot read $prop from $repo/$f"
        if grep -qE "$prop.*by[[:space:]]+extra\(" "$f"; then
            warn "$repo/$f uses 'by extra(...)' — run the bump-version skill (it migrates + bumps), then: ./cascade prep $repo"
            exit 3
        fi
        if [ "$kind" = retarget ]; then
            next="$(mget "$wave" .target)"
            if [ "$cur" != "$next" ]; then
                cur_re="${cur//./\\.}"
                sed_inplace "s/${cur_re}/${next}/" "$f"
                git commit -q -m "Set version -> \`${next}\`" -- "$f"
                note "$repo version $cur -> $next"
            fi
        else
            if git diff --quiet "origin/$BASE...HEAD" -- "$f" 2>/dev/null; then
                printf '%s' "$cur" | grep -qE 'SNAPSHOT\.[0-9]+$' \
                    || { warn "'$cur' is not a snapshot line — run the bump-version skill, then: ./cascade prep $repo"; exit 3; }
                local pre suf w
                pre="${cur%.*}"; suf="${cur##*.}"; w="${#suf}"
                next="$pre.$(printf "%0${w}d" "$((10#$suf + 1))")"
                cur_re="${cur//./\\.}"
                sed_inplace "s/${cur_re}/${next}/" "$f"
                git commit -q -m "Bump version -> \`${next}\`" -- "$f"
                note "$repo version $cur -> $next"
            else
                next="$(version_of "$repo")"
                note "already bumped on this branch ($next) — skipping"
            fi
        fi
        mset "$wave" '.repos[$r].target_version = $v' --arg r "$repo" --arg v "${next:-$cur}"
    fi
    note "prep done: $repo on '$branch'. Next: ./cascade build $repo"
}

# ---------------------------------------------------------------------------
# build — sequential gradle build + mavenLocal publication
# ---------------------------------------------------------------------------

cmd_build() {
    local repo="${1:?usage: cascade build <repo>}" wave
    wave="$(active_wave)"
    require_submodule "$repo"; require_java
    [ "$(mget "$wave" '.halted // empty')" = "" ] || { warn "wave is halted: $(mget "$wave" .halted)"; exit 5; }
    local dir="$SUMMIT/$repo" cls branch
    cls="$(meta_class "$repo")"; branch="$(mget "$wave" .branch)"
    cd "$dir"
    [ "$(git rev-parse --abbrev-ref HEAD)" = "$branch" ] || die "$repo is not on $branch — run: ./cascade prep $repo"

    # Self-gate: script-internal gradle bypasses the PreToolUse hooks, so the
    # version guard is re-implemented here (mirrors publish-version-gate.sh).
    if [ "$cls" = library ] && [ -x ".agents/skills/version-bumped/scripts/version-bumped.sh" ]; then
        VERSION_BUMPED_BASE="origin/$BASE" .agents/skills/version-bumped/scripts/version-bumped.sh \
            || { warn "version-bumped gate failed — run: ./cascade prep $repo"; exit 3; }
    fi

    local logf; logf="$(git rev-parse --absolute-git-dir)/cascade-build.log"
    local rounds; rounds="$(mget "$wave" --arg r "$repo" '.repos[$r].adapt_rounds // 0')"

    if ! ./gradlew clean build dokkaGenerate --console=plain >"$logf" 2>&1; then
        if grep -qE 'HTTP/[0-9.]+ 429|Too Many Requests|status code 429' "$logf"; then
            mset "$wave" '.halted = $h' --arg h "Maven Central throttling (HTTP 429) during $repo build $(date -u +%FT%TZ) — do not retry; see the throttling diagnostic recipe"
            warn "HTTP 429 detected — wave halted. Stop all builds now; retrying extends the block (up to 24h)."
            exit 5
        fi
        tail -40 "$logf" >&2
        if [ "$rounds" -ge "$ADAPT_BUDGET" ]; then
            "$0" park "$repo" --reason "adapt budget exhausted ($ADAPT_BUDGET rounds); see $logf"
            warn "$repo auto-parked after $ADAPT_BUDGET adapt rounds"
            exit 0
        fi
        mset "$wave" '.repos[$r].adapt_rounds = (.repos[$r].adapt_rounds // 0) + 1' --arg r "$repo"
        warn "build failed (round $((rounds + 1))/$ADAPT_BUDGET) — run the cascade-adapt skill in $repo, then: ./cascade build $repo"
        warn "full log: $logf"
        exit 3
    fi

    # Publish to mavenLocal where `build` did not already chain it.
    if [ "$cls" = library ]; then
        local tv gp mk
        tv="$(mget "$wave" --arg r "$repo" '.repos[$r].target_version')"
        gp="$(meta_group "$repo")"; mk="$(meta_marker "$repo")"
        if [ ! -d "$M2/$gp/$mk/$tv" ]; then
            ./gradlew publishToMavenLocal --console=plain >>"$logf" 2>&1 \
                || { tail -20 "$logf" >&2; warn "publishToMavenLocal failed — inspect $logf, fix (cascade-adapt), then: ./cascade build $repo"; exit 3; }
        fi
        [ -d "$M2/$gp/$mk/$tv" ] || die "$mk $tv missing from mavenLocal after publish — check spinePublishing modules for $repo"
    fi

    # Dependency reports must change for ensure-reports-updated.yml.
    if [ -d docs/dependencies ]; then
        if [ -n "$(git status --porcelain docs/dependencies/)" ]; then
            git add docs/dependencies/
            git commit -q -m "Update dependency reports"
        elif git diff --quiet "origin/$BASE...HEAD" -- docs/dependencies/; then
            warn "docs/dependencies/ unchanged on this branch — ensure-reports-updated.yml would fail the PR."
            warn "Investigate (cascade-adapt), then: ./cascade build $repo"
            exit 3
        fi
    fi

    mset "$wave" '.repos[$r].built = {head: $h, at: $t}' \
        --arg r "$repo" --arg h "$(git rev-parse HEAD)" --arg t "$(date -u +%FT%TZ)"
    note "build done: $repo. Next: run the pre-pr skill in $repo, then ./cascade ship $repo"
}

# ---------------------------------------------------------------------------
# ship — gates, push, PR
# ---------------------------------------------------------------------------

cmd_ship() {
    local repo="${1:?usage: cascade ship <repo>}" wave
    wave="$(active_wave)"
    require_submodule "$repo"
    local dir="$SUMMIT/$repo" branch
    branch="$(mget "$wave" .branch)"
    cd "$dir"

    # Sentinel gate (same check pre-pr-gate.sh runs; exit 3 so the loop can route).
    local gitdir head s_head s_status
    gitdir="$(git rev-parse --absolute-git-dir)"; head="$(git rev-parse HEAD)"
    s_head="$(sed -n 's/^head=//p' "$gitdir/pre-pr.ok" 2>/dev/null || true)"
    s_status="$(sed -n 's/^status=//p' "$gitdir/pre-pr.ok" 2>/dev/null || true)"
    { [ "$s_status" = PASS ] && [ "$s_head" = "$head" ]; } \
        || { warn "no PASS pre-pr sentinel for HEAD in $repo — run the pre-pr skill, then: ./cascade ship $repo"; exit 3; }

    # Upstream-published gate: every pinned in-wave version must be public.
    local up pv
    for up in $(upstreams_of "$wave" "$repo"); do
        pv="$(mget "$wave" --arg r "$repo" --arg u "$up" '.repos[$r].pin_vector[$u] // empty')"
        [ -n "$pv" ] || continue
        if ! registry_has "$up" "$pv"; then
            # Drift check: did the upstream move past our pin (re-bump)?
            local upcur; upcur="$(version_of "$up" "$branch" 2>/dev/null || version_of "$up")"
            if [ -n "$upcur" ] && [ "$upcur" != "$pv" ]; then
                warn "upstream $up re-bumped ($pv -> $upcur) — run: ./cascade refresh $repo"; exit 3
            fi
            warn "waiting: $up $pv not yet in the registry"; exit 4
        fi
    done

    # Floor gate: every version pinned in this repo's own pin files must be
    # public, derived BY CONTENT (see unpublished_pins) -- the upstream gate
    # above sees only forward upstreams recorded in pin_vector.
    local floors wait_only up_r up_v where tv_up
    floors="$(unpublished_pins "$repo")"
    if [ -n "$floors" ]; then
        wait_only=1
        while read -r up_r up_v where; do
            [ -n "$up_r" ] || continue
            tv_up="$(mget "$wave" --arg r "$up_r" '.repos[$r].target_version // empty')"
            [ "$tv_up" = "$up_v" ] || wait_only=0
            warn "  $where -> $up_r $up_v (not in the registry)"
        done <<EOF
$floors
EOF
        if [ "$wait_only" = 1 ]; then
            warn "waiting: the pins above are in-wave versions not published yet"
            exit 4
        fi
        warn "$repo pins versions the registry does not serve and this wave will not publish."
        warn "Lower the floor to a published version, rebuild, then: ./cascade ship $repo"
        exit 3
    fi

    git checkout -- docs/dependencies/ 2>/dev/null || true
    if gh pr view "$branch" -R "$ORG/$repo" --json url >/dev/null 2>&1; then
        git push -q origin "$branch"
        note "PR already open: $(gh pr view "$branch" -R "$ORG/$repo" --json url --jq .url)"
    else
        git push -u origin "$branch"
        gh pr create --base "$BASE" --head "$branch" \
            --title "$(pr_title)" \
            --body-file "$SUMMIT/docs/rollout/rebuild-pr-body.md"
    fi
    mset "$wave" '.repos[$r].pr = {url: $u, head: $h}' --arg r "$repo" \
        --arg u "$(gh pr view "$branch" -R "$ORG/$repo" --json url --jq .url)" --arg h "$head"
    checkpoint_state "$wave" || true
}

pr_title() {
    local wave kind; wave="$(active_wave)"; kind="$(mget "$wave" .kind)"
    case "$kind" in
        retarget) echo "Set version to \`$(mget "$wave" .target)\`" ;;
        *)        echo "Rebuild with refreshed dependencies" ;;
    esac
}

# ---------------------------------------------------------------------------
# refresh — drift repair after an upstream re-bump
# ---------------------------------------------------------------------------

cmd_refresh() {
    local repo="${1:?usage: cascade refresh <repo>}" wave
    wave="$(active_wave)"
    # Clear the recorded pins so prep re-reads the upstreams' current versions,
    # then invalidate the build record (the branch will gain commits).
    mset "$wave" '.repos[$r].pin_vector = {} | .repos[$r].built = null' --arg r "$repo"
    "$0" prep "$repo"
    warn "pins refreshed — rebuild + review required: ./cascade build $repo, pre-pr, ./cascade ship $repo"
    exit 3
}

# ---------------------------------------------------------------------------
# park / resume
# ---------------------------------------------------------------------------

cmd_park() {
    local repo="${1:?usage: cascade park <repo> --reason \"...\"}" reason=""
    shift
    [ "${1:-}" = "--reason" ] && reason="${2:-}"
    [ -n "$reason" ] || die "a --reason is mandatory for park"
    local wave; wave="$(active_wave)"
    mset "$wave" '.repos[$r].parked = $why | .repos[$r].state = "parked"' --arg r "$repo" --arg why "$reason"
    printf -- '- %s — **parked** `%s`: %s\n' "$(date +%F)" "$repo" "$reason" >> "$TASKS_DIR/$wave.md"
    note "$repo parked: $reason"
}

cmd_resume() {
    local repo="${1:?usage: cascade resume <repo>}" wave
    wave="$(active_wave)"
    mset "$wave" '.repos[$r].parked = null | .repos[$r].adapt_rounds = 0' --arg r "$repo"
    # A halted wave needs explicit human acknowledgement too.
    mset "$wave" '.halted = null'
    printf -- '- %s — resumed `%s`.\n' "$(date +%F)" "$repo" >> "$TASKS_DIR/$wave.md"
    note "$repo resumed"
}

# ---------------------------------------------------------------------------
# await — background watcher: exit 0 the moment the action set changes
# ---------------------------------------------------------------------------

cmd_await() {
    local timeout_min=30 wave
    [ "${1:-}" = "--timeout-min" ] && timeout_min="${2:-30}"
    wave="$(active_wave)"
    local before now deadline merged_any interval
    before="$("$0" next 2>/dev/null || true)"
    deadline=$(( $(date +%s) + timeout_min * 60 ))
    while [ "$(date +%s)" -lt "$deadline" ]; do
        merged_any="$(printf '%s' "$before" | grep -c WAIT-PUBLISH || true)"
        if [ "${merged_any:-0}" -gt 0 ]; then interval=75; else interval=300; fi
        sleep "$interval"
        now="$("$0" next 2>/dev/null || true)"
        [ "$(mget "$wave" '.halted // empty')" != "" ] && { warn "wave halted"; exit 5; }
        if [ "$now" != "$before" ]; then
            echo "CHANGED:"; printf '%s\n' "$now"
            exit 0
        fi
    done
    echo "TIMEOUT after ${timeout_min}m — no change"; exit 4
}

# ---------------------------------------------------------------------------
# close — the closing config PR recording the final vector
# ---------------------------------------------------------------------------

cmd_close() {
    local wave ship=0
    wave="$(active_wave)"
    [ "${1:-}" = "--ship" ] && ship=1
    local cfg="$SUMMIT/config" vbranch repo tv pf c cur cur_re
    vbranch="$(mget "$wave" .wave)-vector"
    require_submodule config

    # Preconditions: every non-parked library repo published-remote.
    for repo in $(wave_repos "$wave"); do
        [ "$(meta_class "$repo")" = library ] || continue
        [ "$(mget "$wave" --arg r "$repo" '.repos[$r].parked // empty')" != "" ] && continue
        tv="$(mget "$wave" --arg r "$repo" '.repos[$r].target_version // empty')"
        registry_has "$repo" "$tv" || die "$repo $tv not yet published — close is premature"
    done

    cd "$cfg"
    if [ "$(git rev-parse --abbrev-ref HEAD)" != "$vbranch" ]; then
        git fetch --quiet origin "$BASE"; git checkout -q "$BASE"; git pull --ff-only --quiet origin "$BASE"
        git switch -q -c "$vbranch" 2>/dev/null || git switch -q "$vbranch"
    fi
    # Advance every constant — track AND published-floor — to the wave versions,
    # all provably published by the precondition above.
    for repo in $(wave_repos "$wave"); do
        [ "$(meta_class "$repo")" = library ] || continue
        [ "$(mget "$wave" --arg r "$repo" '.repos[$r].parked // empty')" != "" ] && continue
        tv="$(mget "$wave" --arg r "$repo" '.repos[$r].target_version')"
        pf="buildSrc/src/main/kotlin/io/spine/dependency/local/$(repo_pin_file "$repo")"
        [ -f "$pf" ] || continue
        # Only the pin object's OWN constants, which sit at indent 4. A nested
        # object declares a different artifact on its own version line — e.g.
        # `ToolBase.JavadocFilter.version` is `spine-javadoc-filter`, versioned
        # independently of `tool-base`. Matching it would pin that artifact at a
        # version it was never published under.
        # A no-match `grep` exits 1, which under `pipefail` would abort the
        # whole run; warn instead, so a pin file whose shape changed is loud
        # rather than silently skipped.
        pins="$(grep -oE "$(pin_const_re "$PIN_CONSTANTS")[^\"]+\"" "$pf" || true)"
        [ -n "$pins" ] || warn "$repo: no version constant matched in $(basename "$pf") — left untouched"
        printf '%s\n' "$pins" \
        | while read -r line; do
            [ -n "$line" ] || continue
            c="$(printf '%s' "$line" | sed -E 's/.*val ([A-Za-z]+).*/\1/')"
            cur="$(printf '%s' "$line" | sed -E 's/.*"([^"]+)".*/\1/')"
            [ "$cur" = "$tv" ] && continue
            write_pin_constant "$pf" "$c" "$cur" "$tv"
        done
    done
    if [ -n "$(git status --porcelain buildSrc/src/main/kotlin/io/spine/dependency/local/)" ]; then
        git add buildSrc/src/main/kotlin/io/spine/dependency/local/
        git commit -q -m "Update local dependency pins"
    fi
    if [ "$ship" = 1 ]; then
        git push -u origin "$vbranch"
        gh pr create -R "$ORG/config" --base "$BASE" --head "$vbranch" \
            --title "Record the \`$wave\` version vector" \
            --body "Advances \`io.spine.dependency.local\` pins to the versions published by wave \`$wave\`. All versions verified present in the registry before this PR was opened."
        mset "$wave" '.closing_pr = $u' --arg u "$(gh pr view "$vbranch" -R "$ORG/config" --json url --jq .url)"
        checkpoint_state "$wave" || true
    else
        warn "vector staged on config branch '$vbranch' — run the pre-pr skill in config, then: ./cascade close --ship"
        exit 3
    fi
}

# ---------------------------------------------------------------------------
# state checkpoints — commit the manifest pair on summit's wave branch
# ---------------------------------------------------------------------------

checkpoint_state() {
    local wave="$1"
    cd "$SUMMIT"
    git add "$TASKS_DIR/$wave.json" "$TASKS_DIR/$wave.md" 2>/dev/null || return 0
    git diff --cached --quiet 2>/dev/null && return 0
    git commit -q -m "Update cascade state" -- "$TASKS_DIR/$wave.json" "$TASKS_DIR/$wave.md" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------

CMD="${1:-}"; shift || true
# Global --wave flag (before or after the subcommand's own args). Collected in
# an array so multi-word arguments (a quoted --reason) survive intact.
ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --wave) export CASCADE_WAVE="$2"; shift 2 ;;
        *) ARGS[${#ARGS[@]}]="$1"; shift ;;
    esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}

case "$CMD" in
    graph)   cmd_graph "$@" ;;
    plan)    cmd_plan "$@" ;;
    status)  cmd_status "$@" ;;
    next)    cmd_next "$@" ;;
    prep)    cmd_prep "$@" ;;
    build)   cmd_build "$@" ;;
    ship)    cmd_ship "$@" ;;
    refresh) cmd_refresh "$@" ;;
    park)    cmd_park "$@" ;;
    resume)  cmd_resume "$@" ;;
    await)   cmd_await "$@" ;;
    close)   cmd_close "$@" ;;
    *) cat <<EOF
usage: cascade <subcommand> [args] [--wave <slug>]

wave:      graph [--check] | plan --kind <k> [...] | status | next [--json]
           await [--timeout-min N] | close [--ship]
per repo:  prep <repo> | build <repo> | ship <repo> | refresh <repo>
           park <repo> --reason "..." | resume <repo>

See docs/rollout/rebuild.md for the playbook and docs/dependency-graph.md
for the build-order contract.
EOF
       exit 2 ;;
esac

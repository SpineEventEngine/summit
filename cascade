manifest_path() { echo "$TASKS_DIR/$1.json"; }

# Resolve the active wave: explicit $CASCADE_WAVE / --wave beats a lone manifest.
active_wave() {
    if [ -n "${CASCADE_WAVE:-}" ]; then echo "$CASCADE_WAVE"; return 0; fi
    local m n
    m="$(ls "$TASKS_DIR"/cascade-*.json 2>/dev/null || true)"
    n="$(printf '%s\n' "$m" | grep -c . || true)"
    [ "$n" = 1 ] || die "cannot infer the wave: found $n manifests — pass --wave <slug> or set CASCADE_WAVE"
    basename "$m" .json

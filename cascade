usage_plan() {
    cat <<EOF
usage: cascade plan --kind refresh|ripple|retarget
                    [--seed <repo>[@<version>]]   (ripple)
                    [--target <version>]          (retarget)
                    [--include <repo>]... [--exclude <repo>]...
EOF
    exit 2
}

cmd_plan() {
    local kind="" seed="" seed_ver="" target="" includes="" excludes=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --kind) kind="$2"; shift 2 ;;
            --seed) seed="${2%%@*}"; case "$2" in *@*) seed_ver="${2#*@}" ;; esac; shift 2 ;;
            --target) target="$2"; shift 2 ;;
            --include) includes="$includes $2"; shift 2 ;;
            --exclude) excludes="$excludes $2"; shift 2 ;;
            *) usage_plan ;;
        esac
    done
    case "$kind" in refresh|ripple|retarget) ;; *) usage_plan ;; esac
    [ "$kind" = ripple ] && [ -z "$seed" ] && usage_plan
    [ "$kind" = retarget ] && [ -z "$target" ] && usage_plan

    "$0" graph --check

    # Trigger + slug.
    local cfg_sha slug
    git -C "$SUMMIT/config" fetch --quiet origin "$BASE" 2>/dev/null || true
    cfg_sha="$(git -C "$SUMMIT/config" rev-parse "origin/$BASE" 2>/dev/null \
               || git -C "$SUMMIT/config" rev-parse HEAD)"
    case "$kind" in
        refresh)  slug="cascade-refresh-$(echo "$cfg_sha" | cut -c1-7)" ;;
        ripple)   slug="cascade-ripple-$seed-${seed_ver##*.}" ;;
        retarget) slug="cascade-retarget-$target" ;;
    esac

    # Scope. Only forward (wave-ordering) edges scope and order a wave; floor
    # edges are consumed at last-published versions and impose nothing.
    local edges fwd scope repo
    edges="$(stored_edges)"
    fwd="$(printf '%s\n' "$edges" | forward_edges)"
    case "$kind" in
        ripple)
            # Downstream transitive closure of the seed (seed included).
            scope="$(printf '%s\n' "$fwd" | awk -v s="$seed" '
                { down[$1] = down[$1] " " $2 }
                END {
                    q = s; seen[s] = 1
                    while (q != "") {
                        n = split(q, a, " "); q = ""
                        for (i = 1; i <= n; i++) {
                            m = split(down[a[i]], b, " ")
                            for (j = 1; j <= m; j++)
                                if (b[j] != "" && !seen[b[j]]) { seen[b[j]] = 1; q = q " " b[j] }
                        }
                    }
                    for (r in seen) print r
                }')"
            ;;
        *) scope="$(repos_all | tr ' ' '\n')" ;;
    esac

    # Exclusions: defaults minus --include, plus --exclude.
    local final="" excluded_json="{}" reason
    for repo in $scope; do
        reason="$(excluded_reason "$repo")"
        case " $includes " in *" $repo "*) reason="" ;; esac
        case " $excludes " in *" $repo "*) reason="excluded by --exclude" ;; esac
        if [ -n "$reason" ]; then
            excluded_json="$(printf '%s' "$excluded_json" | jq --arg r "$repo" --arg why "$reason" '. + {($r): $why}')"
        else
            final="$final $repo"
        fi
    done

    # Validate probe markers once, loudly. Auth gaps (GitHub Packages without
    # read:packages) warn instead of dying — the scope must exist before ship.
    local bad="" noauth="" rc
    for repo in $final; do
        rc=0; registry_marker_ok "$repo" || rc=$?
        case "$rc" in
            1) bad="$bad $repo" ;;
            2) noauth="$noauth $repo" ;;
        esac
    done
    [ -z "$bad" ] || die "probe marker not found in the registry for:$bad — fix repo_meta() in this script first"
    [ -z "$noauth" ] || warn "GitHub Packages probe unauthorized for:$noauth — before shipping those repos run: gh auth refresh -h github.com -s read:packages"

    # Carryover: an open cascade-* PR from an earlier wave keeps the repo out.
    local carry=""
    for repo in $final; do
        [ "$(meta_class "$repo")" = "verify-only" ] && continue
        if gh pr list -R "$ORG/$repo" --state open --json headRefName \
             --jq '.[].headRefName' 2>/dev/null | grep -q '^cascade-'; then
            carry="$carry $repo"
        fi
    done
    if [ -n "$carry" ]; then
        warn "open cascade PRs already exist in:$carry"
        warn "close or merge them first, or exclude those repos (--exclude); superseding a reviewed PR is a human decision."
        exit 1
    fi

    # Wave order = the canonical order (which is what makes the forward-edge
    # set acyclic by construction). Sanity-check that invariant anyway.
    local order
    order="$(repos_all | tr ' ' '\n')"
    printf '%s\n' "$fwd" | tsort >/dev/null 2>&1 \
        || { warn "forward edges are not acyclic — canonical order and derivation disagree; fix docs/dependency-graph.md first"; exit 3; }

    # Manifest.
    mkdir -p "$TASKS_DIR"
    local repos_json="{}" ups gp mk vp cls tv
    for repo in $final; do
        ups="$(printf '%s\n' "$fwd" | awk -v r="$repo" '$2==r{print $1}' \
               | filter_in_set "$final" | jq -R . | jq -s 'map(select(length > 0))')"
        gp="$(meta_group "$repo")"; mk="$(meta_marker "$repo")"
        vp="$(meta_vprop "$repo")"; cls="$(meta_class "$repo")"
        tv="null"
        [ "$kind" = retarget ] && [ "$cls" = library ] && tv="\"$target\""
        repos_json="$(printf '%s' "$repos_json" | jq \
            --arg r "$repo" --argjson ups "$ups" --arg gp "$gp" --arg mk "$mk" \
            --arg vp "$vp" --arg cls "$cls" --argjson tv "$tv" \
            '. + {($r): {upstreams: $ups, class: $cls, version_property: $vp,
                         probe: {group_path: $gp, artifact: $mk},
                         state: "pending", target_version: $tv, pin_vector: {},
                         adapt_rounds: 0, built: null, pr: null, parked: null}}')"
    done
    jq -n \
        --arg wave "$slug" --arg kind "$kind" --arg base "$BASE" \
        --arg cfg "$cfg_sha" --arg seed "$seed" --arg seed_ver "$seed_ver" \
        --arg target "$target" --arg created "$(date -u +%FT%TZ)" \
        --argjson repos "$repos_json" --argjson excluded "$excluded_json" \
        --argjson order "$(printf '%s\n' "$order" | jq -R . | jq -s .)" \
        '{schema: 1, wave: $wave, kind: $kind, created: $created, base: $base,
          config_sha: $cfg,
          seed: (if $seed == "" then null else {repo: $seed, version: $seed_ver} end),
          target: (if $target == "" then null else $target end),
          branch: $wave, halted: null, order: $order,
          repos: $repos, excluded: $excluded, closing_pr: null}' \
        > "$(manifest_path "$slug")"

    # Companion task file for humans/agents.
    local md="$TASKS_DIR/$slug.md"
    if [ ! -f "$md" ]; then
        {
            printf -- '---\nslug: %s\nbranch: %s\nowner: cascade\nstatus: in-progress\nstarted: %s\n---\n\n' \
                "$slug" "$slug" "$(date +%F)"
            printf '# Wave `%s` (%s)\n\nMachine state: [`%s.json`](%s.json). Park reasons and decisions land here.\n\n## Repos\n\n' \
                "$slug" "$kind" "$slug" "$slug"
            for repo in $final; do printf -- '- [ ] %s\n' "$repo"; done
            printf '\n## Log\n\n- %s — wave planned.\n' "$(date +%F)"
        } > "$md"
    fi

    echo "Wave $slug ($kind) planned — $(printf '%s' "$final" | wc -w | tr -d ' ') repos."
    echo "Build order (graph toposort, wave repos only):"
    for repo in $order; do
        case " $final " in *" $repo "*) echo "   $repo  <- $(upstreams_of "$slug" "$repo" || true)";; esac
    done
    [ "$excluded_json" != "{}" ] && { echo "Excluded:"; printf '%s' "$excluded_json" | jq -r 'to_entries[] | "   \(.key): \(.value)"'; }
    echo "Review the order, then: ./cascade next"
}


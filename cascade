# mget <wave> [jq-args...] <program> — the program is always the LAST argument.
mget() {
    local wave="$1"; shift
    local args=("$@") n prog
    n=${#args[@]}
    prog="${args[$((n - 1))]}"
    unset "args[$((n - 1))]"
    jq -r ${args[@]+"${args[@]}"} "$prog" "$(manifest_path "$wave")"
}
mset() { # <wave> <jq-program> [--arg k v ...]
    local wave="$1" prog="$2"; shift 2
    local p tmp; p="$(manifest_path "$wave")"; tmp="$p.tmp"
    jq "$@" "$prog" "$p" > "$tmp" && mv "$tmp" "$p"
}

wave_repos() { mget "$1" '.repos | keys[]'; }

upstreams_of() { # <wave> <repo> -> in-wave upstreams (space list)
    mget "$1" --arg r "$2" '.repos[$r].upstreams[]?' 2>/dev/null | tr '\n' ' ' | sed 's/ $//'
}


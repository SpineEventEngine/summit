#!/usr/bin/env bash
#
# cascade — deterministic mechanics for cross-repository waves across the
# Spine SDK submodules of this superproject.
#
# A *wave* propagates a change through the repos in dependency order: per repo —
# `./config/pull`, refresh local dependency pins, bump/assign the version, build,
# publish to mavenLocal, and open a PR once every pinned upstream version is
# provably published in the public registry. Three wave kinds:
#
#   refresh   — `config` master advanced; every repo rebuilds on the new baseline.
#   ripple    — one upstream repo published a new version; its downstream
#               transitive closure rebuilds.
#   retarget  — a coordinated version assignment (e.g. `2.0.0-M1`) across all repos.
#
# Owns only what must NOT be re-interpreted each run (branching, pin edits, the
# version fast path, builds, gates, PR mechanics, state derivation). Judgement
# steps — fixing build breakage (`cascade-adapt` skill), the pre-PR review
# (`pre-pr` skill), and the bump edge cases (`bump-version` skill) — are
# agent-driven and requested via exit code 3. See docs/rollout/rebuild.md.
#
# Exit codes (uniform):
#   0  success or idempotent no-op
#   1  hard environment/usage-independent error
#   2  usage
#   3  agent required — the message names the skill and the resume command
#   4  waiting on an external event (upstream unpublished, await timeout)
#   5  wave halt — registry throttling detected; do NOT retry builds
#
# Re-runnable: state is derived from git, GitHub, the registry, and ~/.m2 —
# never from memory — so any interrupted step resumes cleanly when re-invoked.
#
set -euo pipefail

SUMMIT="$(cd "$(dirname "$0")" && pwd)"
BASE="master"
ORG="SpineEventEngine"
TASKS_DIR="$SUMMIT/.agents/tasks"
GRAPH_FILE="$SUMMIT/docs/dependency-graph.md"
REGISTRY="https://europe-maven.pkg.dev/spine-event-engine"
M2="${HOME}/.m2/repository"
ADAPT_BUDGET=3

note() { echo "-- $*"; }
warn() { echo "!! $*" >&2; }
die()  { warn "$*"; exit 1; }

command -v jq >/dev/null 2>&1 || die "jq is required"
command -v gh >/dev/null 2>&1 || die "gh is required"

# BSD (macOS) and GNU sed disagree on -i; wrap once so Linux runners need no fork.
sed_inplace() {
    if sed --version >/dev/null 2>&1; then sed -i "$@"; else sed -i '' "$@"; fi
}

# --- Pin-file constants ------------------------------------------------------
# A pin object's OWN constants sit at indent 4. A nested object declares a
# DIFFERENT artifact on its own version line — `ToolBase.JavadocFilter.version`
# is `spine-javadoc-filter`, versioned independently of `tool-base` — so a match
# must never reach deeper indentation. All declaration forms in use are
# accepted: `const val`, `private const val`, and the `override val` of a
# `Dependency()` subclass.
PIN_CONSTANTS='version|versionForBuildScript|dogfoodingVersion|fallbackVersion|fallbackDfVersion'

pin_const_re() { # <name-or-alternation>
    printf '^ {4}(private )?(const |override )?val (%s)(: String)? = "' "$1"
}

# Value of one constant, or empty. Never fails: a no-match `grep` exits 1,
# which under `pipefail` would abort the caller before it could report.
read_pin_constant() { # <file> <name>
    grep -E "$(pin_const_re "$2")" "$1" 2>/dev/null | head -1 \
        | sed -E 's/.*"([^"]+)".*/\1/' || true
}

# Same, reading the file out of a git ref rather than the work tree.
read_pin_constant_at() { # <dir> <ref> <path> <name>
    git -C "$1" show "$2:$3" 2>/dev/null | grep -E "$(pin_const_re "$4")" | head -1 \
        | sed -E 's/.*"([^"]+)".*/\1/' || true
}

# Rewrites one constant in place, anchored so a nested object cannot match.
write_pin_constant() { # <file> <name> <old> <new>
    local old_re="${3//./\\.}"
    sed_inplace -E "s/^( {4}(private )?(const |override )?val ($2)(: String)? = \")$old_re(\")/\1$4\6/" "$1"
}

# ---------------------------------------------------------------------------
# Static knowledge. Everything here is verified at `plan` time (probe markers
# against the registry; graph vs fresh derivation), so a wrong entry fails
# loudly on the first run instead of silently mis-ordering a wave.
# ---------------------------------------------------------------------------

# Candidate repos in CANONICAL WAVE ORDER. The raw dependency graph is cyclic —
# the SDK is self-hosting (base-libraries consumes logging and the compiler,
# which consume base-libraries) — so a plain toposort cannot order a wave.
# This recorded order is the decision that cuts the cycles: within a wave a repo
# re-pins the wave versions of upstreams EARLIER in this order (forward edges);
# anything later stays at its last-published (floor) version and catches up in
# the next wave — exactly the generation-lag pattern the repos already live by.
# Changing this order is a reviewed change to docs/dependency-graph.md.
repos_all() {
    echo "base-libraries reflect logging testlib dokka-tools tool-base \
ProtoTap compiler validation core-jvm-compiler base-types change time money \
core-jvm jdbc-storage gcloud-jvm delivery-server BuildSpeed"
}

# Position of a repo in the canonical order (1-based; 0 = unknown).
order_pos() {
    local i=1 r
    for r in $(repos_all); do
        [ "$r" = "$1" ] && { echo "$i"; return; }
        i=$((i + 1))
    done
    echo 0
}

# Manual edges the file-grep cannot see (dependencies wired through
# config-distributed convention scripts rather than repo-owned build files).
extra_edges() {
    echo "core-jvm-compiler core-jvm"
}

# Default exclusions, with reasons surfaced by `plan`.
excluded_reason() {
    case "$1" in
        documentation) echo "Spine 1.x; not part of the SDK build line" ;;
        reflect|money|testlib)
            echo "straggler: config submodule generations behind — first pull is a migration (opt in via --include)" ;;
        *) echo "" ;;
    esac
}

# io.spine.dependency.local object -> owning repo. `Spine` carries only group
# constants and maps to nothing.
obj_to_repo() {
    case "$1" in
        Base) echo base-libraries ;;
        BaseTypes) echo base-types ;;
        Change) echo change ;;
        Compiler) echo compiler ;;
        CoreJvm) echo core-jvm ;;
        CoreJvmCompiler) echo core-jvm-compiler ;;
        Logging) echo logging ;;
        ProtoTap) echo ProtoTap ;;
        Reflect) echo reflect ;;
        TestLib) echo testlib ;;
        Time) echo time ;;
        ToolBase) echo tool-base ;;
        Validation) echo validation ;;
        *) echo "" ;;
    esac
}

# repo -> pin file (relative to a consumer's buildSrc local/ dir).
repo_pin_file() {
    case "$1" in
        base-libraries) echo Base.kt ;;
        base-types) echo BaseTypes.kt ;;
        change) echo Change.kt ;;
        compiler) echo Compiler.kt ;;
        core-jvm) echo CoreJvm.kt ;;
        core-jvm-compiler) echo CoreJvmCompiler.kt ;;
        logging) echo Logging.kt ;;
        ProtoTap) echo ProtoTap.kt ;;
        reflect) echo Reflect.kt ;;
        testlib) echo TestLib.kt ;;
        time) echo Time.kt ;;
        tool-base) echo ToolBase.kt ;;
        validation) echo Validation.kt ;;
        *) echo "" ;;
    esac
}

# Constants that TRACK the wave (advance to the upstream's wave version).
# Everything not listed here stays put during a wave; the published-floor
# constants (versionForBuildScript, dogfoodingVersion, fallbackDfVersion) feed
# buildscript/pluginManagement classpaths that cannot see mavenLocal and are
# advanced only by `close`, when the wave's versions are provably published.
repo_track_constants() {
    case "$1" in
        compiler) echo "fallbackVersion" ;;
        *) echo "version" ;;
    esac
}

# repo -> "group-path|marker-artifact|version-property|class|registry"
# marker-artifact: one definitely-published artifact used for registry probes.
# class: library (full pipeline) | verify-only (no version/publishing steps).
# registry: gcar (public europe-maven.pkg.dev) | github (GitHub Packages —
# delivery-server is proprietary and publishes only there; probes authenticate
# with `gh auth token`).
repo_meta() {
    case "$1" in
        base-libraries)    echo "io/spine|spine-base|versionToPublish|library|gcar" ;;
        base-types)        echo "io/spine|spine-base-types|versionToPublish|library|gcar" ;;
        change)            echo "io/spine|spine-change|versionToPublish|library|gcar" ;;
        time)              echo "io/spine|spine-time|versionToPublish|library|gcar" ;;
        money)             echo "io/spine|spine-money|versionToPublish|library|gcar" ;;
        reflect)           echo "io/spine|spine-reflect|versionToPublish|library|gcar" ;;
        logging)           echo "io/spine|spine-logging|versionToPublish|library|gcar" ;;
        testlib)           echo "io/spine/tools|base-testlib|versionToPublish|library|gcar" ;;
        dokka-tools)       echo "io/spine/tools|dokka-extensions|versionToPublish|library|gcar" ;;
        tool-base)         echo "io/spine/tools|jvm-tools|versionToPublish|library|gcar" ;;
        ProtoTap)          echo "io/spine/tools|prototap-gradle-plugin|versionToPublish|library|gcar" ;;
        compiler)          echo "io/spine/tools|compiler-jvm|compilerVersion|library|gcar" ;;
        validation)        echo "io/spine/tools|validation-java|validationVersion|library|gcar" ;;
        core-jvm-compiler) echo "io/spine/tools|core-jvm-gradle-plugin|coreJvmCompilerVersion|library|gcar" ;;
        core-jvm)          echo "io/spine|spine-core|versionToPublish|library|gcar" ;;
        jdbc-storage)      echo "io/spine|spine-rdbms|versionToPublish|library|gcar" ;;
        gcloud-jvm)        echo "io/spine/gcloud|spine-datastore|versionToPublish|library|gcar" ;;
        delivery-server)   echo "io/spine/delivery|spine-delivery-server|versionToPublish|library|github" ;;
        BuildSpeed)        echo "|||verify-only|" ;;
        *) echo "" ;;
    esac
}
meta_group()  { repo_meta "$1" | cut -d'|' -f1; }
meta_marker() { repo_meta "$1" | cut -d'|' -f2; }
meta_vprop()  { repo_meta "$1" | cut -d'|' -f3; }
meta_class()  { repo_meta "$1" | cut -d'|' -f4; }
meta_reg()    { repo_meta "$1" | cut -d'|' -f5; }

# ---------------------------------------------------------------------------
# Shared helpers
# ---------------------------------------------------------------------------

require_submodule() {
    git -C "$SUMMIT/$1" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
        || die "no initialised submodule at $1 (try: git submodule update --init $1)"
}

require_java() {
    # Validate, never trust: a jenv/profile JAVA_HOME may point at an old JDK
    # (observed: corretto 11 while the SDK builds on 17 — Gradle refuses).
    local want=17 ver
    ver="$("${JAVA_HOME:-/nonexistent}/bin/java" -version 2>&1 \
           | sed -nE 's/.*version "([0-9]+).*/\1/p' | head -1)"
    if ! [ "${ver:-0}" -ge "$want" ] 2>/dev/null; then
        JAVA_HOME="$(/usr/libexec/java_home -v "$want" 2>/dev/null || true)"
    fi
    export JAVA_HOME
    [ -n "${JAVA_HOME:-}" ] || die "no JDK $want found (JAVA_HOME was unset or pointed at an older JVM)"
}

# Version literal fed to the given extra property, both spellings:
#   extra.set("prop", "X")   |   val prop ... by extra("X")
version_of() { # <repo> [<ref>]  -> current version literal (empty if none)
    local dir="$SUMMIT/$1" prop content v alias
    prop="$(meta_vprop "$1")"
    [ -n "$prop" ] || return 0
    if [ -n "${2:-}" ]; then
        content="$(git -C "$dir" show "$2:version.gradle.kts" 2>/dev/null || true)"
    else
        content="$(cat "$dir/version.gradle.kts" 2>/dev/null || true)"
    fi
    # 1) The property named on the same line as a quoted version literal —
    #    covers `extra.set("prop", "X")`, `val prop = "X"`, and
    #    `val prop: String by extra("X")` alike.
    v="$(printf '%s\n' "$content" | grep -E "(^|[^A-Za-z])$prop([^A-Za-z]|$)" \
         | grep -oE '"[0-9][0-9A-Za-z.-]*"' | head -1 | tr -d '"' || true)"
    if [ -z "$v" ]; then
        # 2) Indirection: `extra.set("prop", alias)` — resolve the alias.
        alias="$(printf '%s\n' "$content" \
                 | sed -nE "s/.*extra\\.set\\(\"$prop\", *([A-Za-z_][A-Za-z0-9_]*)\\).*/\\1/p;\
                            s/.*$prop[^=]*by[[:space:]]+extra\\(([A-Za-z_][A-Za-z0-9_]*)\\).*/\\1/p" | head -1)"
        [ -n "$alias" ] && v="$(printf '%s\n' "$content" \
            | sed -nE "s/.*[^A-Za-z]$alias[[:space:]]*=[[:space:]]*\"([0-9][0-9A-Za-z.-]*)\".*/\\1/p" | head -1)"
    fi
    printf '%s' "$v"
}

# All metadata XML the repo's registry serves for its marker artifact.
marker_metadata() { # <repo>
    local gp mk r
    gp="$(meta_group "$1")"; mk="$(meta_marker "$1")"
    [ -n "$gp" ] || return 0
    case "$(meta_reg "$1")" in
        github)
            # Requires a token with read:packages; a 401 is an auth gap, not a
            # missing artifact — surfaced separately by gh_packages_code().
            curl -sf --max-time 20 -u "x:$(gh auth token)" \
                "https://maven.pkg.github.com/$ORG/$1/$gp/$mk/maven-metadata.xml" 2>/dev/null || true ;;
        *)
            for r in snapshots releases; do
                curl -sf --max-time 20 "$REGISTRY/$r/$gp/$mk/maven-metadata.xml" 2>/dev/null || true
            done ;;
    esac
}

# Does the repo's registry serve <version> of its marker artifact?
registry_has() { # <repo> <version>
    marker_metadata "$1" | grep -q "<version>$2</version>"
}

# File.kt -> repo (reverse of repo_pin_file); empty when not a repo pin file.
pin_file_repo() { # <File.kt>
    local r
    for r in $(repos_all); do
        [ "$(repo_pin_file "$r")" = "$1" ] && { echo "$r"; return; }
    done
    echo ""
}

# Versions this repo pins in its own local pin files that the registry does NOT
# serve, derived BY CONTENT. `pin_vector` records only forward (wave-ordering)
# upstreams; published-floor pins point *backwards* in the canonical order and
# never appear there, so a manifest-driven check is structurally blind to a
# floor raised past the registry -- while CI resolves from the registry alone
# and would fail to resolve it. Only top-level constants are read: a nested
# object (e.g. ToolBase.JavadocFilter) versions a different artifact and would
# be probed under the wrong marker.
unpublished_pins() { # <repo> -> "<upstream> <version> <File.kt>:<constant>" lines
    local dir="$SUMMIT/$1" pf base up line c v cache
    cache="$(mktemp)"
    for pf in "$dir"/buildSrc/src/main/kotlin/io/spine/dependency/local/*.kt; do
        [ -f "$pf" ] || continue
        base="$(basename "$pf")"
        up="$(pin_file_repo "$base")"
        { [ -n "$up" ] && [ -n "$(meta_group "$up")" ]; } || continue
        { grep -E '^    (private |internal |const |override )*val (version|versionForBuildScript|dogfoodingVersion|fallbackVersion|fallbackDfVersion)(: String)? *= *"' "$pf" || true; } \
        | while IFS= read -r line; do
            c="$(printf '%s' "$line" | sed -E 's/.*val ([A-Za-z]+).*/\1/')"
            v="$(printf '%s' "$line" | sed -E 's/.*"([^"]+)".*/\1/')"
            grep -qx "$up $v OK" "$cache" 2>/dev/null && continue
            if grep -qx "$up $v NO" "$cache" 2>/dev/null; then
                printf '%s %s %s:%s\n' "$up" "$v" "$base" "$c"; continue
            fi
            if registry_has "$up" "$v"; then
                echo "$up $v OK" >>"$cache"
            else
                echo "$up $v NO" >>"$cache"
                printf '%s %s %s:%s\n' "$up" "$v" "$base" "$c"
            fi
        done
    done
    rm -f "$cache"
}

# HTTP code GitHub Packages returns for the repo's marker (github registry only).
gh_packages_code() { # <repo>
    curl -s -o /dev/null -w '%{http_code}' --max-time 20 -u "x:$(gh auth token)" \
        "https://maven.pkg.github.com/$ORG/$1/$(meta_group "$1")/$(meta_marker "$1")/maven-metadata.xml" 2>/dev/null
}

# Marker validation for `plan`: 0 = ok, 1 = marker wrong, 2 = auth gap (github
# registry, token without read:packages — probes will work once the scope is
# added; ship/close hard-require it).
registry_marker_ok() { # <repo>
    [ -n "$(meta_group "$1")" ] || return 0   # verify-only repos carry no marker
    [ -n "$(marker_metadata "$1")" ] && return 0
    if [ "$(meta_reg "$1")" = github ] && [ "$(gh_packages_code "$1")" = 401 ]; then
        return 2
    fi
    return 1
}

# ---------------------------------------------------------------------------
# graph — derive/verify docs/dependency-graph.md
# ---------------------------------------------------------------------------

# Emit "upstream downstream scope" triples derived from consumer-owned build
# files. An edge requires an actual USAGE of the dependency object (a bare
# import proves nothing and stale imports do occur). Scope classes:
#   main  — declared dependency or applied plugin (api/implementation/...)
#   test  — test-only declarations (testImplementation/testFixtures*/...)
# References inside version-management constructs (force/constraints/exclude)
# create no edge at all — see the classifier below.
# Every repo's buildSrc *contains* all local objects post-pull, so only files
# the repo itself owns are scanned.
derive_scoped() {
    local repo files f objs o up usages subpaths sp skip
    for repo in $(repos_all); do
        [ -d "$SUMMIT/$repo" ] || continue
        # The repo's own nested submodules are other repositories' content
        # (validation/docs/_time is the vendored `time` repo) — never scan them.
        subpaths="$(git config -f "$SUMMIT/$repo/.gitmodules" --get-regexp '\.path$' 2>/dev/null | awk '{print $2}')"
        files=""
        for f in "$SUMMIT/$repo"/build.gradle.kts \
                 "$SUMMIT/$repo"/*/build.gradle.kts \
                 "$SUMMIT/$repo"/*/*/build.gradle.kts \
                 "$SUMMIT/$repo"/settings.gradle.kts \
                 "$SUMMIT/$repo"/buildSrc/src/main/kotlin/module.gradle.kts; do
            case "$f" in
                */config/*|*/buildSrc/*/build.gradle.kts) continue ;;
            esac
            [ -f "$f" ] || continue
            skip=0
            for sp in $subpaths; do
                case "$f" in "$SUMMIT/$repo/$sp"/*) skip=1 ;; esac
            done
            [ "$skip" = 1 ] || files="$files $f"
        done
        [ -n "$files" ] || continue
        # shellcheck disable=SC2086
        objs="$(grep -hoE 'io\.spine\.dependency\.local\.[A-Z][A-Za-z]+' $files 2>/dev/null \
                | sed 's/.*\.//' | sort -u)"
        # Block-aware classification: a reference creates an edge only where
        # it is a declared dependency. References inside version-management
        # constructs — force(...), constraints {...}, exclude(...) — create NO
        # edge: those lists are routinely copy-pasted between repositories and
        # pin versions of artifacts that may not occur in this project at all
        # (proven by ProtoTap, whose force list names the Compiler while its
        # dependencies blocks never do). Bare `Obj.member,` lines inside a
        # `dependencies { listOf(...) }` are real declarations (see
        # compiler/api) and default to main scope.
        for o in $objs; do
            up="$(obj_to_repo "$o")"
            [ -n "$up" ] && [ "$up" != "$repo" ] || continue
            # shellcheck disable=SC2086
            scopes="$(awk -v obj="$o" '
                function push(tag) { sp++; tags[sp] = tag; depths[sp] = depth }
                {
                    line = $0
                    if (line ~ /^[[:space:]]*(import|\/\/|\*)/) { updepth(); next }
                    # Accept both the bare `Obj.member` (backed by an import)
                    # and the fully-qualified `io.spine.dependency.local.Obj.member`,
                    # which is the house style inside `buildscript {}` where
                    # file-level imports do not apply. The leading guard still
                    # rejects an unrelated `Something.Obj.member`.
                    use = match(line, "(^|[^.A-Za-z])(io\\.spine\\.dependency\\.local\\.)?" obj "\\.[A-Za-z]")
                    if (use) {
                        if (line ~ /(^|[^A-Za-z])test[A-Za-z]*\(/)        print "test"
                        else if (line ~ /(^|[^A-Za-z])(api|implementation|compileOnly|compileOnlyApi|runtimeOnly|annotationProcessor|classpath|kapt|ksp)\(/) print "main"
                        else if (line ~ /(^|[^A-Za-z])(force|exclude|constraints|forceArtifacts)[[:space:]]*[({]/) { }
                        else if (sp > 0 && tags[sp] == "vm") { }
                        else if (sp > 0 && tags[sp] == "deps") print "main"
                        # any other context (dokka config, interpolation, ...) -> no edge
                    }
                    # context openers seen on this line, at current depth
                    if (line ~ /(^|[^A-Za-z])(force|constraints|forceArtifacts|exclude)[[:space:]]*[({]/) push("vm")
                    else if (line ~ /(^|[^A-Za-z])dependencies[[:space:]]*\{/) push("deps")
                    updepth()
                }
                function updepth(   i, c) {
                    for (i = 1; i <= length($0); i++) {
                        c = substr($0, i, 1)
                        if (c == "{" || c == "(") depth++
                        if (c == "}" || c == ")") {
                            depth--
                            while (sp > 0 && depth <= depths[sp]) sp--
                        }
                    }
                }' $files 2>/dev/null | sort -u)"
            case "$scopes" in
                *main*) echo "$up $repo main" ;;
                *test*) echo "$up $repo test" ;;
            esac
        done
        # Plugin applications: bare convention accessors (`prototap` alone in a
        # plugins block) and plugin-id strings — dependencies the object-deref
        # grep above cannot see. Provider mapping:
        #   prototap / io.spine.prototap                  -> ProtoTap
        #   spineCompiler / io.spine.compiler             -> compiler
        #   coreJvmCompiler / io.spine.core-jvm           -> core-jvm-compiler
        #   io.spine.{artifact-meta,descriptor-set-file,
        #             generated-sources}                  -> tool-base
        # shellcheck disable=SC2086
        {
            grep -hE '^[[:space:]]*(prototap|spineCompiler|coreJvmCompiler)[[:space:]]*$' $files 2>/dev/null \
                | sed 's/[[:space:]]//g' | sort -u \
                | sed 's/^prototap$/ProtoTap/; s/^spineCompiler$/compiler/; s/^coreJvmCompiler$/core-jvm-compiler/'
            grep -hoE '"io\.spine\.(prototap|compiler|core-jvm|artifact-meta|descriptor-set-file|generated-sources)"' $files 2>/dev/null \
                | tr -d '"' | sort -u \
                | sed 's/^io\.spine\.prototap$/ProtoTap/; s/^io\.spine\.compiler$/compiler/; s/^io\.spine\.core-jvm$/core-jvm-compiler/; s/^io\.spine\..*$/tool-base/'
        } | sort -u | while read -r up; do
            [ -n "$up" ] && [ "$up" != "$repo" ] && echo "$up $repo main"
        done
        # shellcheck disable=SC2086
        if [ "$repo" != testlib ]; then
            { grep -qE '^[[:space:]]*`module-testing`[[:space:]]*$' $files 2>/dev/null \
                && echo "testlib $repo test"; } || true
            { grep -qE '^[[:space:]]*`kmp-module`[[:space:]]*$' $files 2>/dev/null \
                && echo "testlib $repo main"; } || true
        fi
    done | { cat; extra_edges | sed 's/$/ main/'; } | apply_scope_rules
}

# Owner-decided scope overrides, then collapse duplicate (up, down) pairs to
# their strongest scope (main > test > other) so each edge renders exactly once.
# ProtoTap is test-only BY DECISION: it taps `protoc` output in tests and is
# never a production dependency of any repository.
apply_scope_rules() {
    awk '
    $1 == "ProtoTap" { $3 = "test" }
    {
        rank = ($3 == "main") ? 3 : ($3 == "test") ? 2 : 1
        key = $1 " " $2
        if (rank > best[key]) { best[key] = rank; scope[key] = $3 }
    }
    END { for (k in best) print k " " scope[k] }' | sort
}

# The plain relation (all scopes) — what the machine list stores and waves use.
derive_edges() { derive_scoped | awk '{print $1 " " $2}' | sort -u; }

# Split "up down" pairs on stdin into build-ordering (forward) or
# previously-published (floor) edges against the canonical order.
forward_edges() { while read -r a b; do [ "$(order_pos "$a")" -lt "$(order_pos "$b")" ] && echo "$a $b"; done || true; }
floor_edges()   { while read -r a b; do [ "$(order_pos "$a")" -ge "$(order_pos "$b")" ] && echo "$a $b"; done || true; }

# Transitive reduction of the forward-edge DAG on stdin ("a b" lines):
# drop every edge implied by a longer path. Rendering-only — the FULL edge set
# stays canonical (each edge is a direct pin the wave must advance).
reduce_edges() {
    awk '
    { e[$1 SUBSEP $2] = 1; seen[$1] = 1; seen[$2] = 1; lines[NR] = $0 }
    END {
        for (x in seen) nodes[++N] = x
        for (i = 1; i <= N; i++) for (j = 1; j <= N; j++)
            r[nodes[i] SUBSEP nodes[j]] = e[nodes[i] SUBSEP nodes[j]]
        for (k = 1; k <= N; k++) for (i = 1; i <= N; i++) for (j = 1; j <= N; j++)
            if (r[nodes[i] SUBSEP nodes[k]] && r[nodes[k] SUBSEP nodes[j]])
                r[nodes[i] SUBSEP nodes[j]] = 1
        for (l = 1; l <= NR; l++) {
            split(lines[l], p, " "); a = p[1]; b = p[2]; red = 0
            for (k = 1; k <= N; k++) {
                m = nodes[k]
                if (m != a && m != b && e[a SUBSEP m] && r[m SUBSEP b]) { red = 1; break }
            }
            if (!red) print a " " b
        }
    }'
}

# stdin lines filtered to members of the space-separated set in $1.
# (Kept out of command substitutions: bash 3.2 cannot parse `case` inside $().)
filter_in_set() {
    local set=" $1 " x
    while read -r x; do
        [ -n "$x" ] || continue
        printf '%s' "$set" | grep -qF " $x " && echo "$x"
    done
    return 0
}
floor_edges()   { while read -r a b; do [ "$(order_pos "$a")" -ge "$(order_pos "$b")" ] && echo "$a $b"; done || true; }

